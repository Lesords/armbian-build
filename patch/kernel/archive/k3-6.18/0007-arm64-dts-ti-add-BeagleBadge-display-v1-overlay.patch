From 53970b0dd33a6c7eaf7447e69f1d8e02fc75b1a1 Mon Sep 17 00:00:00 2001
From: Lesords <lesords168@gmail.com>
Date: Mon, 14 Sep 2026 20:07:11 +0800
Subject: [PATCH 2/3] arm64: dts: ti: add BeagleBadge display-v1 overlay

Raspberry Pi Touch Display 1: tc358762 DPI-to-DSI bridge, attiny MCU
@0x45 regulator (with the OMAP I2C SMBus fix) and EDT FT5406 touch.
Build-verified only; the physical V1 unit is dead.
---
 arch/arm64/boot/dts/ti/Makefile               |   1 +
 .../dts/ti/k3-am62l3-badge-display-v1.dtso    | 128 ++++++++++++++++++
 2 files changed, 129 insertions(+)
 create mode 100644 arch/arm64/boot/dts/ti/k3-am62l3-badge-display-v1.dtso

diff --git a/arch/arm64/boot/dts/ti/Makefile b/arch/arm64/boot/dts/ti/Makefile
index 57a082e..f338f39 100644
--- a/arch/arm64/boot/dts/ti/Makefile
+++ b/arch/arm64/boot/dts/ti/Makefile
@@ -592,3 +592,4 @@ DTC_FLAGS_k3-j784s4-evm += -@
 DTC_FLAGS_k3-j742s2-evm += -@
 
 dtb-$(CONFIG_ARCH_K3) += k3-am62l3-badge-beaglebadge-extras.dtbo
+dtb-$(CONFIG_ARCH_K3) += k3-am62l3-badge-display-v1.dtbo
diff --git a/arch/arm64/boot/dts/ti/k3-am62l3-badge-display-v1.dtso b/arch/arm64/boot/dts/ti/k3-am62l3-badge-display-v1.dtso
new file mode 100644
index 0000000..8545cfe
--- /dev/null
+++ b/arch/arm64/boot/dts/ti/k3-am62l3-badge-display-v1.dtso
@@ -0,0 +1,128 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * BeagleBadge DSI display overlay — Raspberry Pi Touch Display 1 (V1):
+ *   tc358762 DPI-to-DSI bridge + attiny MCU @0x45 (power/backlight/GPIO)
+ *   + EDT FT5406 touch @0x38.
+ * Mutually exclusive with display-v2 (same I2C addr 0x45, same DSI link).
+ * Chain verified to build only — the physical V1 unit is dead.
+ */
+
+/dts-v1/;
+/plugin/;
+
+#include <dt-bindings/gpio/gpio.h>
+
+/* ---- v12: DSI display chain (RPi 7" touchscreen), from the board dts ---- */
+
+&i2c1 {
+	bb_display_reg: bb-display-reg@45 {
+		compatible = "raspberrypi,7inch-touchscreen-panel-regulator";
+		reg = <0x45>;
+		gpio-controller;
+		#gpio-cells = <2>;
+	};
+
+	bb_touch: bb-touch@38 {
+		compatible = "edt,edt-ft5406";
+		reg = <0x38>;
+		touchscreen-size-x = <800>;
+		touchscreen-size-y = <480>;
+		vcc-supply = <&bb_display_reg>;
+		reset-gpio = <&bb_display_reg 1 1>;
+		touchscreen-inverted-x;
+		touchscreen-inverted-y;
+	};
+};
+
+/ {
+	fragment@52 {
+		target-path = "/";
+		__overlay__ {
+
+		bb_bridge_reg: bb-bridge-regulator {
+			compatible = "regulator-fixed";
+			regulator-name = "bridge-reg";
+			gpio = <&bb_display_reg 0 0>;
+			vin-supply = <&bb_display_reg>;
+			enable-active-high;
+		};
+
+		bb_panel0: bb-panel0 {
+			compatible = "raspberrypi,7inch-dsi", "simple-panel";
+			backlight = <&bb_display_reg>;
+			power-supply = <&bb_display_reg>;
+			port {
+				bb_panel_in: endpoint {
+					remote-endpoint = <&bb_panel_bridge_out>;
+				};
+			};
+		};
+		};
+	};
+};
+
+&dss {
+	status = "okay";
+};
+
+&dphy_tx0 {
+	status = "okay";
+};
+
+&dss_ports {
+	port@0 {
+		reg = <0>;
+		bb_dpi_out: endpoint {
+			remote-endpoint = <&bb_dsi0_in>;
+		};
+	};
+};
+
+&dsi0 {
+	status = "okay";
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@0 {
+			reg = <0>;
+			bb_dsi0_out: endpoint {
+				remote-endpoint = <&bb_panel_bridge_in>;
+			};
+		};
+
+		port@1 {
+			reg = <1>;
+			bb_dsi0_in: endpoint {
+				remote-endpoint = <&bb_dpi_out>;
+			};
+		};
+	};
+
+	bridge@0 {
+		compatible = "toshiba,tc358762";
+		reg = <0>;
+		vddc-supply = <&bb_bridge_reg>;
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				bb_panel_bridge_in: endpoint {
+					remote-endpoint = <&bb_dsi0_out>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				bb_panel_bridge_out: endpoint {
+					remote-endpoint = <&bb_panel_in>;
+				};
+			};
+		};
+	};
+};
-- 
