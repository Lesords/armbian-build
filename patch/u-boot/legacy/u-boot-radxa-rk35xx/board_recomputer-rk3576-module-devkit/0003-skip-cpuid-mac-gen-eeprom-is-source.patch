From: Seeed Studio <techsupport@seeed.cc>
Subject: [PATCH] rockchip: misc: skip cpuid MAC generation, EEPROM is the MAC source

diff -urN a/arch/arm/mach-rockchip/misc.c b/arch/arm/mach-rockchip/misc.c
--- a/arch/arm/mach-rockchip/misc.c	2026-09-22 13:49:44.717724803 +0800
+++ b/arch/arm/mach-rockchip/misc.c	2026-09-22 13:49:44.741234315 +0800
@@ -36,6 +36,15 @@
 	int size = sizeof(hash);
 	u8 mac_addr[6];
 
+	/*
+	 * reComputer RK3576 Module Dev Kit: the on-module EEPROM is the sole
+	 * MAC source (imported by the boot script before booti). Skip the
+	 * cpuid-derived generation so it cannot occupy the write-once
+	 * ethaddr slot first. Boards without a programmed EEPROM fall back
+	 * to a kernel-side random MAC.
+	 */
+	return 0;
+
 	/* Only generate a MAC address, if none is set in the environment */
 	if (env_get("ethaddr"))
 		return 0;
